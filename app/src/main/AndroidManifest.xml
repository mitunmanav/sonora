<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Hiding an app from the home screen by disabling its launcher activity. -->
    <uses-permission
        android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE"
        tools:ignore="ProtectedPermissions" />
    <!-- Stopping an app that is running in the background. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- The app manager asks the system to uninstall an app, with the user's
         confirmation. Without it the system refuses and nothing is removed. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- The name of the Wi-Fi network, shown in the device panel. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Reads the state of the network so the quick settings can say whether
         the TV is online. It cannot send anything anywhere. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Load photos from device storage for the screensaver. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Only ever used by the optional browser, and only once it is switched on. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Only for Files, which is off until the user opens it, and only once they allow it. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/sonora_banner"
        android:icon="@drawable/sonora_mark"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sonora"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".HomeActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- The "all apps" screen Android expects a home app to provide.
                 Sonora's grid is that screen, so the intent just brings it up. -->
            <intent-filter>
                <action android:name="android.intent.action.ALL_APPS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".tools.ToolActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".tools.ShareActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".browser.BrowserActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="landscape" />

        <service
            android:name=".dream.SonoraDreamService"
            android:exported="true"
            android:label="@string/dream_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
            </intent-filter>
        </service>
    </application>

</manifest>
