<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Hiding an app from the home screen by disabling its launcher activity. -->
    <uses-permission android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
    <!-- Stopping an app that is running in the background. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- The name of the Wi-Fi network, shown in the device panel. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Only ever used by the optional browser, and only once it is switched on. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sonora"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".HomeActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".tools.ToolActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".tools.ShareActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".browser.BrowserActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Hands local files to other apps as content URIs. -->
        <provider
            android:name=".SonoraProvider"
            android:authorities="com.mitun.sonora.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".dream.SonoraDreamService"
            android:exported="true"
            android:label="@string/dream_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
            </intent-filter>
        </service>
    </application>

</manifest>
