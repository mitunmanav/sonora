<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext is allowed because a typed http:// address is how the browser
    reaches LAN devices: the router's page, a computer's share, Sonora's own
    share server. A <domain> entry names one literal host and cannot express
    an IP range, so the private ranges cannot be listed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
