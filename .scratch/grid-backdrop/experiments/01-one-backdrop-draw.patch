@@ -0,0 +1,28 @@
+package com.mitun.sonora.ui;
+
+import static org.junit.Assert.assertEquals;
+
+import org.junit.Test;
+
+public class GridBackdropBlendTest {
+    @Test
+    public void fusedBlendMatchesTwoDrawsToWithinTwoColorLevels() {
+        int[][] themes = {{179, 0}, {209, 247}};
+        for (int[] theme : themes) {
+            for (int progress = 0; progress <= 255; progress++) {
+                float fade = progress / 255f;
+                float oldScrim = theme[0] / 255f * fade;
+                int opacity = GridBackdropBlend.opacity(progress, theme[0]);
+                float newAlpha = opacity / 255f;
+                float tint = GridBackdropBlend.tint(progress, theme[0]) / 255f;
+                for (int blur : new int[]{0, 63, 160, 255}) {
+                    float twoDraws = (blur * fade + 140 * (1f - fade)) * (1f - oldScrim)
+                            + theme[1] * oldScrim;
+                    float oneDraw = (blur * (1f - tint) + theme[1] * tint) * newAlpha
+                            + 140 * (1f - newAlpha);
+                    assertEquals(twoDraws, oneDraw, 2f);
+                }
+            }
+        }
+    }
+}
