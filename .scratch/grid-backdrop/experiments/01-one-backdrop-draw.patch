diff --git a/app/src/main/java/com/mitun/sonora/ui/GridBackdropBlend.java b/app/src/main/java/com/mitun/sonora/ui/GridBackdropBlend.java
new file mode 100755
index 0000000..efe93db
--- /dev/null
+++ b/app/src/main/java/com/mitun/sonora/ui/GridBackdropBlend.java
@@ -0,0 +1,19 @@
+package com.mitun.sonora.ui;
+
+/** Folds the faded blur and the faded scrim above it into one source-over draw. */
+final class GridBackdropBlend {
+    private GridBackdropBlend() {}
+
+    private static float combined(int progress, int scrim) {
+        float fade = progress / 255f;
+        return progress + scrim * fade * (1f - fade);
+    }
+
+    static int opacity(int progress, int scrim) {
+        return Math.round(combined(progress, scrim));
+    }
+
+    static int tint(int progress, int scrim) {
+        return progress == 0 ? 0 : Math.round(scrim * progress / combined(progress, scrim));
+    }
+}
